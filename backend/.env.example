# ==============================================================================
# Portfolio Backend (FastAPI) - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' inside the 'backend' directory:
#    cp .env.example .env
# 2. Update with your local database credentials and allowed origins.
# 3. DO NOT commit '.env' to version control (it is strictly gitignored).
# ==============================================================================

# Database Connection (MySQL / MariaDB via PyMySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/portfolio_db

# Cross-Origin Resource Sharing (CORS) - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server Information
APP_NAME=Portfolio Backend API
DEBUG=true
