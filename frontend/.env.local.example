# ==============================================================================
# Portfolio Frontend - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' in the 'frontend' directory:
#    cp .env.local.example .env.local
# 2. Fill in your valid SMTP and email recipient credentials below.
# 3. DO NOT commit '.env.local' to version control (it is strictly gitignored).
# ==============================================================================

# Public API Gateway (points to FastAPI backend if running, otherwise uses internal route)
NEXT_PUBLIC_API_URL=

# Gmail SMTP Email Address used for sending inquiry alerts:
# Example: your-portfolio-sender@gmail.com
SMTP_USER=your_email@gmail.com

# 16-character Google App Password (Generate from: https://myaccount.google.com/apppasswords)
# Note: Requires 2-Factor Authentication enabled on your Google account.
SMTP_PASS=your_google_app_password_here

# Recipient Email Address where visitor contact messages should be delivered:
CONTACT_RECEIVER_EMAIL=your_inbox@example.com
